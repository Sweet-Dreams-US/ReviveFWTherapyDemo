{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/founders", "destination": "/pricing", "permanent": true },
    { "source": "/founding", "destination": "/pricing", "permanent": true },
    { "source": "/100", "destination": "/pricing", "permanent": true },
    { "source": "/100.html", "destination": "/pricing", "permanent": true },
    { "source": "/about", "destination": "/why-revive", "permanent": true },
    { "source": "/about.html", "destination": "/why-revive", "permanent": true },
    { "source": "/experience", "destination": "/why-revive", "permanent": true },
    { "source": "/experience.html", "destination": "/why-revive", "permanent": true },
    { "source": "/giveaway", "destination": "/", "permanent": true },
    { "source": "/giveaway.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
